{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/demo.c",
                "${workspaceFolder}/Sfc/*.c",
                "-I",
                "${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/demo.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler task generated by debugger."
        }
    ],
    "version": "2.0.0"
}